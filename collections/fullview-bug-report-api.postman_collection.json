          "name": "Start a bug recording",
          "request": {
            "name": "Start a bug recording",
            "description": {
              "content": "Starts a Fullview bug recording (session replay) for the identified end user so a support agent can review the reproduction. Optionally carries help-desk integration context (platform, workspace, case).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "access",
                "api",
                "integrations",
                "bug-report",
                "start"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organisationId\": \"<string>\",\n  \"externalId\": \"<string>\",\n  \"email\": \"<email>\",\n  \"integrationData\": {\n    \"platform\": \"<string>\",\n    \"workspaceId\": \"<string>\",\n    \"caseId\": \"<string>\"\n  }\n}",
